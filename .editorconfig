root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml,json}]
indent_size = 2

# Le CSV d'exemple reproduit le format d'export : CRLF et BOM préservés.
[*.csv]
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = false
